<%- include('partials/header') %>

<div class="container">
  <div class="header">
    <h1>Admin Dashboard</h1>
    <div>
      <span style="margin-right: 20px;"><%= adminEmail %></span>
      <a href="/admin/logout">Logout</a>
    </div>
  </div>

  <div class="content">
    
    <h2>Add New User</h2>
    <% if (locals.error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    
    <form action="/admin/users/add" method="POST" style="display: flex; gap: 10px; margin-bottom: 30px;">
      <div class="form-group" style="flex: 2; margin: 0;">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="form-group" style="flex: 2; margin: 0;">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
      <div class="form-group" style="flex: 1; margin: 0;">
        <label for="role">Role</label>
        <select id="role" name="role">
          <option value="user">User</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      <button type="submit" class="btn" style="align-self: flex-end;">Add User</button>
    </form>

    <hr style="border: 0; border-top: 1px solid #eee; margin: 30px 0;">

    <h2>Manage Users</h2>
    <table>
      <thead>
        <tr>
          <th>Email</th>
          <th>Role</th>
          <th>User ID</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td><%= user.email %></td>
            <td><%= user.role %></td>
            <td><%= user._id %></td>
            <td>
              <form action="/admin/users/delete/<%= user._id %>" method="POST" style="margin: 0;">
                <button type="submit" class="btn btn-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

  </div>
</div>

<%- include('partials/footer') %>